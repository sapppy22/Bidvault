# ── Database ──────────────────────────────────────────────
# Default: SQLite (no setup needed)
# For Postgres: postgresql://user:password@localhost/bidvault
DATABASE_URL=sqlite:///./auction.db

# ── Auth ──────────────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=change-me-to-a-long-random-string

# Admin credentials (used to seed the first admin on startup)
ADMIN_PASSWORD=admin123

# ── Email (SMTP) ──────────────────────────────────────────
# Leave SMTP_USER blank to disable email notifications entirely
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Image Storage ─────────────────────────────────────────
# Set to true + fill Cloudinary vars to use cloud storage
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
